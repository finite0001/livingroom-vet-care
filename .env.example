# Public browser configuration only. Use an isolated development/staging project.
# Set these explicitly in Vercel; never put service-role/provider secrets in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-staging-publishable-key

# Optional local label used by Lovable/Supabase tooling. Do not rely on it as
# proof of the active browser backend; VITE_SUPABASE_URL is authoritative.
VITE_SUPABASE_PROJECT_ID=replace-with-local-or-staging-project-id

# Public contact form stays disabled until Turnstile and its Edge endpoint are configured.
VITE_CONTACT_INTAKE_URL=
VITE_CONTACT_TURNSTILE_SITE_KEY=

# Supabase Edge Function secrets are configured in Supabase, not Vercel and not
# in this file. See docs/environment-manifest.md for the required secret set:
# APP_URL, APP_ENV, OUTBOUND_DELIVERY_MODE, OUTBOUND_DISPATCHER_TOKEN,
# OUTBOUND_TEST_EMAILS, OUTBOUND_TEST_PHONES, RESEND_*, RESEND_WEBHOOK_SECRET,
# TWILIO_*, TWILIO_STATUS_CALLBACK_URL, TWILIO_INBOUND_WEBHOOK_URL,
# SUPABASE_*, LOVABLE_API_KEY.
