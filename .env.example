# Public browser configuration only. Use an isolated development/staging project.
# Set these explicitly in Vercel; never put service-role/provider secrets in VITE_*.
VITE_SUPABASE_URL=http://127.0.0.1:56321
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-local-or-staging-publishable-key

# Public contact form stays disabled until Turnstile and its Edge endpoint are configured.
VITE_CONTACT_INTAKE_URL=
VITE_CONTACT_TURNSTILE_SITE_KEY=
